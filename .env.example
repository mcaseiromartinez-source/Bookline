# Copia este archivo como .env.local y rellena los valores.
# .env.local NO se sube a GitHub: tus claves se quedan solo en tu ordenador.
# Guía paso a paso para conseguir cada clave: docs/CLAVES.md
# Comprueba qué tienes conectado con: npm run status

# --- 1. Vapi (voz de Lucía) ---
VAPI_API_KEY=
# Se rellena sola con `npm run agent:sync`
VAPI_ASSISTANT_ID=
# Solo para recordatorios por llamada: id del número de teléfono comprado en Vapi
VAPI_PHONE_NUMBER_ID=

# --- 2. Anthropic (cerebro de los agentes) ---
ANTHROPIC_API_KEY=

# --- 3. Telegram (tus avisos y órdenes al agente de ventas) ---
TELEGRAM_BOT_TOKEN=
# Se rellena sola con `npm run telegram:setup`
TELEGRAM_CHAT_ID=
# Se genera sola con `npm run telegram:setup` (cuando haya PUBLIC_BASE_URL)
TELEGRAM_WEBHOOK_SECRET=

# --- 4. Servidor público (Vercel) ---
# URL de la web publicada, sin barra final. Ej: https://atendo.vercel.app
PUBLIC_BASE_URL=
# Se genera sola con `npm run agent:sync` (cuando haya PUBLIC_BASE_URL)
VAPI_WEBHOOK_SECRET=
# Contraseña de la tarea diaria de recordatorios (inventa una larga)
CRON_SECRET=

# --- 5. Supabase (base de datos y panel de clínicas) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- 6. Resend (emails a las clínicas) ---
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend. Ej: Atendo <avisos@atendo.es>
EMAIL_FROM=
# Emails de aviso por defecto si la clínica no tiene ninguno en la base de datos (separados por comas)
CLINIC_NOTIFY_EMAILS=

# --- 7. Google (Sheets y Calendar, misma cuenta de servicio) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# La clave privada en UNA línea, entre comillas, con \n donde haya saltos de línea
GOOGLE_SERVICE_ACCOUNT_KEY=
# Id de la hoja de costes (lo que va entre /d/ y /edit en su URL)
GOOGLE_SHEETS_ID=
# Id del calendario de la clínica (Configuración del calendario → Integrar el calendario)
GOOGLE_CALENDAR_ID=
# Cambio dólar → euro para los costes (opcional)
USD_EUR_RATE=0.92

# --- 8. Google Places (agente de ventas) ---
GOOGLE_PLACES_API_KEY=

# --- 9. Recordatorios a pacientes ---
# Orden de canales a probar
REMINDER_CHANNELS=whatsapp,sms,llamada
# SMS con Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# WhatsApp Business (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=es
