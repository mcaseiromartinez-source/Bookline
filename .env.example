# Copia este archivo como .env.local y rellena los valores.
# .env.local NO se sube a GitHub: tus claves se quedan solo en tu ordenador.

# Clave PRIVADA de Vapi: dashboard.vapi.ai → API Keys → Private Key
VAPI_API_KEY=

# Se rellena sola la primera vez que ejecutas `npm run agent:sync`
# VAPI_ASSISTANT_ID=
